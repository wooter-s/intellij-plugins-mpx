<idea-plugin visibility="private">
  <dependencies>
    <module name="intellij.css"/>
    <module name="intellij.javascript.parser"/>
    <module name="intellij.javascript.psi.impl"/>
    <module name="intellij.javascript.web"/>
    <module name="intellij.libraries.stream"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.polySymbols"/>
    <module name="intellij.platform.polySymbols.web"/>
    <module name="intellij.xml.parser"/>
    <module name="intellij.xml.psi"/>
    <module name="intellij.xml.psi.impl"/>
    <plugin id="com.intellij.modules.platform"/>
    <plugin id="JavaScript"/>
  </dependencies>
  <resource-bundle>messages.VueBundle</resource-bundle>
  <extensions defaultExtensionNs="com.intellij">
    <lang.syntaxHighlighterFactory language="MpxJS"
                                   implementationClass="org.jetbrains.mpxjs.lang.expr.highlighting.VueJSHighlighterFactory"/>
  </extensions>
</idea-plugin>
