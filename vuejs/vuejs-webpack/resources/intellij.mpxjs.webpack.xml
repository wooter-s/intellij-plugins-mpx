    <module name="intellij.javascript.backend"/>
    <module name="intellij.platform.core"/>
    <plugin id="com.intellij.modules.platform"/>
    <plugin id="intellij.webpack"/>
    <module name="intellij.mpxjs.backend"/>
    <module name="intellij.mpxjs.common"/>
  </dependencies>
  <extensions defaultExtensionNs="intellij.webpack">
    <webpackLocator implementation="com.intellij.mpxjs.webpack.VueCliWebpackConfigLocator"/>
