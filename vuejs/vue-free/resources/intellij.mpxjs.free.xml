<idea-plugin>
  <dependencies>
    <module name="intellij.libraries.fastutil"/>
    <module name="intellij.libraries.stream"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.backend.workspace"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.polySymbols"/>
    <module name="intellij.platform.polySymbols.web"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.workspace.storage"/>
    <plugin id="com.intellij.webstorm.customization"/>
    <plugin id="com.intellij.modules.platform"/>
    <plugin id="com.intellij.platform.images"/>
    <module name="intellij.mpxjs.common"/>
  </dependencies>
  <extensions defaultExtensionNs="com.intellij">
    <pluginWithFreeTierEditorNotificationProvider implementation="org.jetbrains.mpxjs.editor.VueFreeTierEditorNotificationProvider"/>
    <polySymbols.webTypes source="web-types/vue-context@0.0.0.web-types.json" enableByDefault="true"/>
  </extensions>
</idea-plugin>
