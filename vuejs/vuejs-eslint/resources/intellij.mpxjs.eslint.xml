<idea-plugin>
  <dependencies>
    <module name="intellij.javascript.web"/>
    <module name="intellij.json"/>
    <module name="intellij.platform.codeStyle"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.xml.parser"/>
    <module name="intellij.xml.psi"/>
    <module name="intellij.xml.psi.impl"/>
    <module name="intellij.xml.ui.common"/>
    <plugin id="com.intellij.modules.platform"/>
    <plugin id="intellij.javascript.eslint"/>
    <module name="intellij.mpxjs.backend"/>
    <module name="intellij.mpxjs.common"/>
  </dependencies>
  <extensions defaultExtensionNs="com.intellij">
    <eslint.ruleMappersFactory implementation="com.intellij.mpxjs.eslint.VueEslintRuleMappersFactory"/>
  </extensions>
</idea-plugin>