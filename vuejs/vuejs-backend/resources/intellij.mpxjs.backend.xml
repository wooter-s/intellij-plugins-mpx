    <handlersFactory language="MpxJS" implementationClass="org.jetbrains.mpxjs.codeInsight.VueJSHandlersFactory"/>
    <handlersFactory language="MpxTS" implementationClass="org.jetbrains.mpxjs.codeInsight.VueTSHandlersFactory"/>
    <handlersFactory language="Mpx"
